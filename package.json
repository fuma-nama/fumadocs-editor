{
  "name": "fumadocs-editor",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --filter=playground",
    "lint": "oxlint",
    "lint:format": "oxfmt --check",
    "format": "oxfmt",
    "test": "pnpm -r test",
    "types:check": "turbo run types:check",
    "tegami": "node scripts/tegami.mts"
  },
  "devDependencies": {
    "oxfmt": "^0.65.0",
    "oxlint": "^1.69.0",
    "tegami": "^0.1.3",
    "tinyexec": "^1.2.4",
    "turbo": "^2.9.18"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.5.3"
}
