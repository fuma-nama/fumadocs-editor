{
  "name": "@fumadocs-editor/ui",
  "version": "0.2.0",
  "description": "MDX editor for Fumadocs: React component with Base UI chrome",
  "keywords": [
    "editor",
    "fumadocs",
    "mdx",
    "react",
    "tiptap",
    "wysiwyg"
  ],
  "homepage": "https://github.com/fuma-nama/fumadocs-editor",
  "license": "MIT",
  "author": "Fuma Nama",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fuma-nama/fumadocs-editor.git",
    "directory": "packages/ui"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": "./dist/index.js",
    "./styles.css": "./dist/index.css",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "types:check": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@fumadocs-editor/core": "workspace:*",
    "@stylexjs/stylex": "0.19.0",
    "@tiptap/core": "^3.31.0",
    "@tiptap/extension-bubble-menu": "^3.31.0",
    "@tiptap/extension-code-block-lowlight": "^3.31.0",
    "@tiptap/extension-image": "^3.31.0",
    "@tiptap/extension-list": "^3.31.0",
    "@tiptap/extension-table": "^3.31.0",
    "@tiptap/pm": "^3.31.0",
    "@tiptap/react": "^3.31.0",
    "@tiptap/starter-kit": "^3.31.0",
    "@tiptap/suggestion": "^3.31.0",
    "highlight.js": "^11.12.0",
    "katex": "^0.18.5",
    "lowlight": "^3.3.0",
    "lucide-react": "^1.23.0",
    "mermaid": "^11.17.2"
  },
  "devDependencies": {
    "@repo/typescript-config": "workspace:*",
    "@stylexjs/rollup-plugin": "0.19.0",
    "@tiptap/extension-collaboration": "^3.31.0",
    "@tiptap/y-tiptap": "3.0.9",
    "@types/katex": "^0.16.8",
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "jsdom": "^30.0.1",
    "tsdown": "^0.22.14",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11",
    "yjs": "^13.6.32"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  }
}
